# Configuration for with-meshmonitor.yml: copy this file to ".env" (with the dot) next
# to it and adjust the values below. No spaces around "=". See docs/meshmonitor.md for
# the full setup guide.

# MeshMonitor's own settings.
# The radio's IP on your network: MeshMonitor connects to it (the bot does not).
MESHTASTIC_NODE_IP=192.168.1.50
# The exact address you'll open the web UI at. Must match exactly: "localhost" and
# "127.0.0.1" count as different origins. Change this (and the port mapping in
# with-meshmonitor.yml) if opening the UI from another machine.
ALLOWED_ORIGINS=http://localhost:8080

# The bot's settings. MTBOT_HOST/MTBOT_PORT point at MeshMonitor's Virtual Node, not
# the radio directly -- leave them as they are.
MTBOT_HOST=meshmonitor
MTBOT_PORT=4404
# The channel's index on the radio, as the app shows it (0 to 7). Use a test channel.
MTBOT_CHANNEL=1
# That channel's name: if it does not match, the bot refuses to transmit. Recommended.
MTBOT_CHANNEL_NAME=TestChannel
# Where you are, at city level. Goes in every message.
MTBOT_PLACE=City

# Every other bot option -- schedule, message prefix, report prefix, and everything
# else -- can also be set here, as MTBOT_<OPTION>. See install/env.example and the
# comments in ../defaults.ini for the full list.
