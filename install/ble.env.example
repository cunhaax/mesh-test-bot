# Configuration for with-ble.yml: copy this file to ".env" (with the dot) next to it and
# change the five values below. No spaces around "=". Guide: docs/no-wifi.md

# The radio's Bluetooth address, from pairing it (bluetoothctl).
BLE_ADDRESS=AA:BB:CC:DD:EE:FF
# The exact address you'll open MeshMonitor at: http://, this machine's IP on your network
# (hostname -I shows it) and :8080. It must match exactly: "localhost" and "127.0.0.1" count
# as different addresses. Use http://localhost:8080 if you browse on this same machine.
ALLOWED_ORIGINS=http://192.168.1.60:8080

# The channel's index on the radio, as the app shows it (0 to 7). Use a test channel.
MTBOT_CHANNEL=1
# That channel's name: if it does not match, the bot refuses to transmit. Recommended.
MTBOT_CHANNEL_NAME=TestChannel
# Where you are, at city level. Goes in every message.
MTBOT_PLACE=City

# Every other bot option -- schedule, message prefix, report prefix, and everything
# else -- can also be set here, as MTBOT_<OPTION>. See install/env.example and
# defaults.ini for the full list.
