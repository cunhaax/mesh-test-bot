# Bot configuration: copy this file to ".env" (with the dot) and adjust the values
# below. No spaces around "=". An empty line, or a variable with no value, counts as
# unset.
#
# Every other option is listed at the end of this file, with its default. To change one,
# remove the "#" at the start of its line. What each one does is explained in defaults.ini,
# under the same name in lower case and without MTBOT_:
# https://github.com/cunhaax/mesh-test-bot/blob/master/defaults.ini

# The radio: its IP on your network (the ".local" name usually does not work inside Docker).
MTBOT_HOST=192.168.1.50
# The channel's index on the radio, as the app shows it (0 to 7). Use a test channel.
MTBOT_CHANNEL=1
# That channel's name: if it does not match, the bot refuses to transmit. Recommended.
MTBOT_CHANNEL_NAME=TestChannel
# Where you are, at city level. Goes in every message.
MTBOT_PLACE=City

# The prefix that tags this bot's messages apart from regular chat (may be several
# words). Whoever wants to hear your messages has to configure the same one.
MTBOT_KEYWORD=MTBOT
# A short prefix repeated at the start of every line in the readable report (report.txt).
MTBOT_REPORT_PREFIX=ACK

# Optional settings. Each line shows the default: remove the "#" to change it.

# The radio's TCP port.
#MTBOT_PORT=4403

# When the session runs: monday..sunday, or "daily". The time is read in MTBOT_TIMEZONE.
#MTBOT_WEEKDAY=saturday
#MTBOT_START_TIME=06:00
#MTBOT_TIMEZONE=Europe/Lisbon

# The session: minutes of sending and listening (at least 30), number of messages (at most
# 10), and minutes after that in which the report comes out (at least 10).
#MTBOT_LISTEN_MINUTES=120
#MTBOT_MESSAGE_COUNT=3
#MTBOT_REPORT_WINDOW_MINUTES=60

# Ask for an acknowledgement when sending (true/false).
#MTBOT_WANT_ACK=true

# The LoRa mode shown in the report. Empty = read it from the radio.
#MTBOT_MODE=
#MTBOT_MODE_ALIASES=BW62-SF7-CR6=NARROW_FAST

# File names, inside the data folder.
#MTBOT_REPORT_FILE=report.txt
#MTBOT_REPORT_JSON_FILE=report.jsonl
#MTBOT_RX_FILE=rx.log

# Also send each report to Telegram: both are needed.
#MTBOT_TELEGRAM_BOT_TOKEN=
#MTBOT_TELEGRAM_CHAT_ID=
