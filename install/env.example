# Bot configuration: copy this file to ".env" (with the dot) and adjust the 4 lines
# below. No spaces around "=". An empty line, or a variable with no value, counts as
# unset.
#
# Every other option -- schedule, message count, window length, and everything else --
# can also be set here, as MTBOT_<OPTION> (e.g. MTBOT_WEEKDAY=saturday). See the
# comments in ../defaults.ini for the full list and what each one does: the same
# names and defaults apply here, just uppercased with an MTBOT_ prefix instead of
# lowercase under [bot].

# The radio: its IP on your network (the ".local" name usually does not work inside Docker).
MTBOT_HOST=192.168.1.50
# The channel's index on the radio, as the app shows it (0 to 7). Use a test channel.
MTBOT_CHANNEL=1
# That channel's name: if it does not match, the bot refuses to transmit. Recommended.
MTBOT_CHANNEL_NAME=TestChannel
# Where you are, at city level. Goes in every message.
MTBOT_PLACE=City
