# Bot configuration: copy this file to ".env" (with the dot) and adjust the 4 lines
# below. Any bot option can go here as MTBOT_<OPTION> (see the README). No spaces
# around "=". An empty line, or a variable with no value, counts as unset.

# The radio: its IP on your network (the ".local" name usually does not work inside Docker).
MTBOT_HOST=192.168.1.50
# The channel's index on the radio, as the app shows it (0 to 7). Use a test channel.
MTBOT_CHANNEL=1
# That channel's name: if it does not match, the bot refuses to transmit. Recommended.
MTBOT_CHANNEL_NAME=TestChannel
# Where you are, at city level. Goes in every message.
MTBOT_PLACE=City

# --- Optional (default values) ---
# Day and time of the test, in the timezone below (the same time everywhere: the bot converts).
#MTBOT_WEEKDAY=saturday
#MTBOT_START_TIME=21:00
#MTBOT_TIMEZONE=Europe/Lisbon
# How many messages per session, and the window length in minutes. With
# random_schedule (the default), more than 5 messages or less than 120 minutes is
# refused -- see the README's "Random-schedule limits" section.
#MTBOT_COUNT=3
#MTBOT_LISTEN_MINUTES=120
# The radio's port (only change it if you're connecting to another service instead of the radio).
#MTBOT_PORT=4403
